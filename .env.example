# US Retailer Product Knowledge Graph - Environment Variables Example
# Copy this file to .env and adjust variables as required for your local setup.

# PostgreSQL Configuration
PG_HOST=localhost
PG_PORT=5445
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=ProductData

# PostgreSQL Views
PG_VIEW_PRODUCTS=global_products_search_mv
PG_VIEW_BRANDS=brands_search_mv
PG_VIEW_CATEGORIES=product_categories_search_mv
PG_VIEW_BRAND_CATEGORY=brand_category_map_mv

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=retailpassword123

# Server Configuration
PORT=3000

# Gemini AI Service Configuration (Optional, defaults to keyword-mapping fallback if missing)
GEMINI_API_KEY=your_gemini_api_key_here
